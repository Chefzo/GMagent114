# Anthropic — digest writer voice
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Toast POS
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=

# Supabase (digest log, approval queue, persistence)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio SMS — owner + bartenders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set once A2P 10DLC approves.
TWILIO_MESSAGING_SERVICE_SID=

# Slack — #one-fourteen-ops mirror
SLACK_BOT_TOKEN=
SLACK_OPS_CHANNEL=#one-fourteen-ops

# RedE App — frontline staff broadcast (redeapp.com)
# Free plan has no API token; keep REDE_DRY_RUN=1 until a paid API token exists
# AND the send payload is verified (see ~/Desktop/rede-mcp). Leaving both auth
# vars blank makes Rede a safe no-op stub, same as missing Twilio/Slack creds.
# REDE_MODE: "direct" (RECOMMENDED — bearer login, sends straight from Vercel) or
# "queue" (legacy — enqueue to Supabase rede_outbox, drained by the local rede-mcp
# worker). Unset = direct.
REDE_MODE=direct
# Direct-mode auth: bearer login as the account that administers One Fourteen
# (same creds BoomBot uses). Or set REDE_API_TOKEN to skip login with a token.
REDE_USERNAME=
REDE_PASSWORD=
REDE_API_TOKEN=
REDE_NETWORK_ID=acd984ed-1a7e-4e98-8e02-5ce0bd73a8e2
REDE_DEFAULT_SUBJECT=One Fourteen GM update
# Broadcast targets (JSON). recipient_type: "group" | "account".
# Default: the RUNDOWN goes to Enzo's account directly (deterministic — the
# Managers group is manual with 1 opaque member, so account targeting is safer).
# When more managers join Rede, switch to the Managers group and add them there.
# Get account/group ids from the Rede MCP or the rede_groups table; the
# real ids live only in Vercel env.
REDE_RECIPIENTS=[{"recipient_id":"<enzo-account-uuid>","recipient_type":"account"}]
# use_case: "direct_message" verified; group broadcasts may prefer "template".
REDE_USE_CASE=

# Dispatch targets
OWNER_PHONE=

# Vercel Cron lockdown — generate with `openssl rand -hex 24`
CRON_SECRET=

# Dry-run flags (preview deploys + local dev). Set to "1" to enable.
# Keep REDE_DRY_RUN=1 in production until Rede send is verified.
DIGEST_DRY_RUN=
TWILIO_DRY_RUN=
SLACK_DRY_RUN=
REDE_DRY_RUN=1
