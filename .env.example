# Anthropic — digest writer voice
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Toast POS
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=

# Supabase (digest log, approval queue, persistence)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio SMS — owner + bartenders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Set once A2P 10DLC approves.
TWILIO_MESSAGING_SERVICE_SID=

# Slack — #one-fourteen-ops mirror
SLACK_BOT_TOKEN=
SLACK_OPS_CHANNEL=#one-fourteen-ops

# Dispatch targets
OWNER_PHONE=

# Vercel Cron lockdown — generate with `openssl rand -hex 24`
CRON_SECRET=

# QuickBooks Online — P&L snapshot
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# Set to "sandbox" for testing against QBO sandbox environment
QBO_ENVIRONMENT=production

# Google Calendar — pre-shift event feed
# Service account JSON key fields (from the downloaded .json key file)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# Comma-separated list of calendar IDs to pull events from
GOOGLE_CALENDAR_IDS=

# Permits — Supabase table name (default: permit_items)
PERMITS_TABLE=permit_items
# Days ahead to alert on upcoming permit expirations
PERMIT_ALERT_DAYS=30

# Dry-run flags (preview deploys + local dev). Set to "1" to enable.
DIGEST_DRY_RUN=
PNL_DRY_RUN=
TWILIO_DRY_RUN=
SLACK_DRY_RUN=
