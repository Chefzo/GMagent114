# =============================================================================
# GM Agent for "114" — credentials & settings
# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# In production these live as GitHub repo secrets (Settings > Secrets > Actions).
# =============================================================================

# --- Anthropic (powers the agent's drafting + chat) -------------------------
ANTHROPIC_API_KEY=

# --- Toast POS (Standard API Access — request from your Toast rep) ----------
# OAuth2 client-credentials. The GUID identifies your restaurant on every call.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
TOAST_RESTAURANT_GUID=
# Production host is https://ws-api.toasttab.com ; sandbox is https://ws-sandbox-api.toasttab.com
TOAST_BASE_URL=https://ws-api.toasttab.com

# --- Sling (admin API token; OAuth2 token endpoint) ------------------------
# Either supply a long-lived token directly, or email+password to fetch one.
SLING_API_TOKEN=
SLING_EMAIL=
SLING_PASSWORD=
SLING_BASE_URL=https://api.getsling.com

# --- Google (Sheets + Gmail + Calendar via one service account) ------------
# Create a service account, download its JSON key, and either:
#   (a) point to the file with GOOGLE_SERVICE_ACCOUNT_FILE, or
#   (b) paste the JSON (single line) into GOOGLE_SERVICE_ACCOUNT_JSON (used in CI).
# Then SHARE the GM spreadsheet (and grant Gmail/Calendar via domain delegation).
GOOGLE_SERVICE_ACCOUNT_FILE=./google-service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=
# The user the service account impersonates for Gmail/Calendar (your bar's Google account).
GOOGLE_IMPERSONATE_USER=
# The GM data spreadsheet ID (from its URL: docs.google.com/spreadsheets/d/<THIS>/edit).
GM_SPREADSHEET_ID=

# --- Ordering / alerts ------------------------------------------------------
# Where approval alerts are sent (you).
OWNER_EMAIL=
# Comma-separated order days the ordering job runs (cron is set in the workflow too).
ORDER_DAYS=Mon,Thu
